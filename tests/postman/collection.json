              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 412\", function () {",
                  "    pm.response.to.have.status(412);",
                  "});",
                  "pm.test(\"Body carries the first-connection token\", function () {",
                  "    const token = pm.response.json().token;",
                  "    pm.expect(token).to.be.a(\"string\").and.not.empty;",
                  "    pm.environment.set(\"first_connection_token\", token);",
                  "});"
