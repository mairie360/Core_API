        {
          "name": "OpenAPI document",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api-docs/openapi.json",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api-docs",
                "openapi.json"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Document is an OpenAPI spec with paths\", function () {",
                  "    const doc = pm.response.json();",
                  "    pm.expect(doc.openapi).to.be.a(\"string\");",
                  "    pm.expect(doc.paths).to.be.an(\"object\");",
                  "    pm.expect(Object.keys(doc.paths)).to.include(\"/api/v1/auth/login\");",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
