{
  "info": {
    "name": "Core API integration tests",
    "description": "End-to-end smoke tests replayed by newman in CI (MAIR-117). `baseUrl` is injected by docker-compose-integration.yml; the default in environment.json targets a local stack. The flow registers a fresh user (unique e-mail generated at run time), walks the first-connection password change, logs in, and exercises the session routes with the issued JWT.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// One fresh account per run so the collection is replayable against a persistent database.",
          "if (!pm.environment.get(\"test_user_email\")) {",
          "    pm.environment.set(\"test_user_email\", `newman.${Date.now()}@mairie360.test`);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Service",
      "item": [
        {
          "name": "Hello",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Body matches the expected text\", function () {",
                  "    pm.expect(pm.response.text()).to.eql(\"Hello, world!\");",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
