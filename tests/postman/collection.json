        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_user_email}}\",\n  \"password\": \"{{test_user_new_password}}\",\n  \"device_info\": \"newman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Authorization header carries a Bearer JWT\", function () {",
                  "    const auth = pm.response.headers.get(\"Authorization\");",
                  "    pm.expect(auth, \"Authorization header\").to.be.a(\"string\");",
                  "    pm.expect(auth).to.match(/^Bearer [A-Za-z0-9\\-_]+\\.[A-Za-z0-9\\-_]+\\.[A-Za-z0-9\\-_]+$/);",
                  "    pm.environment.set(\"jwt\", auth.substring(\"Bearer \".length));",
                  "});",
                  "pm.test(\"Body carries a refresh token\", function () {",
                  "    const token = pm.response.json().refresh_token;",
                  "    pm.expect(token).to.be.a(\"string\").and.not.empty;",
                  "    pm.environment.set(\"refresh_token\", token);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
