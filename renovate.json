{
  "extends": [
    "github>mairie360/renovate-config"
  ],
  "packageRules": [
    {
      "description": "sqlx must stay on the minor mairie360_api_lib uses (DbError::Sqlx is matched across the two crates): bump it together with the lib.",
      "matchPackageNames": [
        "sqlx"
      ],
      "allowedVersions": "0.9.x"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "^\\.github/workflows/cicd\\.yml$"
      ],
      "matchStrings": [
        "cicd_version:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "mairie360/CICD",
      "datasourceTemplate": "github-tags"
    }
  ]
}
